from reference_types import Doc, Span
from spacy.pipeline import EntityRulerPattern

DEFAULT_SPANS_KEY: str

class SpanRuler:
    def __call__(self, doc: Doc) -> Doc: ...
    def __len__(self) -> int: ...
    def __contains__(self, label: str) -> bool: ...
    @property
    def key(self) -> str | None: ...
    def match(self, doc: Doc) -> list[Span]: ...
    @property
    def labels(self) -> tuple[str, ...]: ...
    @property
    def ids(self) -> tuple[str, ...]: ...
    @property
    def patterns(self) -> list[EntityRulerPattern]: ...
    def add_patterns(self, patterns: list[EntityRulerPattern]) -> None: ...
    def remove(self, label: str) -> None: ...
    def remove_by_id(self, pattern_id: str) -> None: ...
    def clear(self) -> None: ...
